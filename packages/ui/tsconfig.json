{
	"extends": "@sofiaflores/tsconfig/react-library.json",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		"strictNullChecks": true,
		"baseUrl": ".",
		"ignoreDeprecations": "6.0",
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
